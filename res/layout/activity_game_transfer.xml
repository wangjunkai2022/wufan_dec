<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:background="@color/activity_default_background" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout android:id="@id/game_transfer_top_rl" android:background="@color/blue_game_transfer" android:layout_width="fill_parent" android:layout_height="@dimen/game_transfer_top_rl_height">
        <ImageView android:id="@id/game_transfer_back_img" android:paddingLeft="@dimen/game_transfer_back_img_margin_left" android:paddingTop="@dimen/game_transfer_back_img_padding_top_bottom" android:paddingRight="@dimen/game_transfer_back_img_padding_right" android:paddingBottom="@dimen/game_transfer_back_img_padding_top_bottom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/back_icon_discover" />
        <TextView android:textSize="@dimen/font_large" android:textColor="@color/white" android:id="@id/game_transfer_title_txt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/game_transfer_title_txt_margin_top" android:text="@string/title_face_transfer_homepage" android:layout_toRightOf="@id/game_transfer_back_img" />
        <ImageView android:id="@id/game_transfer_bar_img" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/game_transfer_bar_margin_top" android:src="@drawable/game_transfer_bar" android:scaleType="centerCrop" android:layout_centerHorizontal="true" />
        <TextView android:id="@id/game_transfer_left_phone_txt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="@dimen/game_transfer_top_phone_txt_margin_left_right" android:text="@string/game_transfer_my_phone" android:layout_toLeftOf="@id/game_transfer_bar_img" style="@style/game_transfer_phone_txt_style" />
        <TextView android:id="@id/game_transfer_right_phone_txt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/game_transfer_top_phone_txt_margin_left_right" android:layout_toRightOf="@id/game_transfer_bar_img" style="@style/game_transfer_phone_txt_style" />
    </RelativeLayout>
    <RelativeLayout android:id="@id/game_transfer_bottom_rl" android:background="@color/white" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_below="@id/game_transfer_top_rl">
        <LinearLayout android:orientation="horizontal" android:id="@id/game_transfer_bottom_navigation_bar_ll" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/game_transfer_nagviation_bar_ll_margin_left_right" android:layout_marginTop="@dimen/game_transfer_nagviation_bar_ll_margin_top" android:layout_marginRight="@dimen/game_transfer_nagviation_bar_ll_margin_left_right">
            <TextView android:id="@id/game_transfer_bottom_navigation_left_txt" android:background="@drawable/bg_game_transfer_left_navigation_bar_txt" android:text="@string/game_transfer_nagivation_bar_choose_game" style="@style/game_transfer_navgiation_bar_txt_style" />
            <TextView android:id="@id/game_transfer_bottom_navigation_right_txt" android:background="@drawable/bg_game_transfer_right_navigation_bar_txt" android:text="@string/game_transfer_nagivation_bar_transfer_recode" style="@style/game_transfer_navgiation_bar_txt_style" />
        </LinearLayout>
        <TextView android:id="@id/game_transfer_selected_num_txt" android:paddingBottom="@dimen/game_transfer_list_select_game_num_txt_padding_bottom" android:visibility="gone" android:layout_marginLeft="@dimen/game_transfer_list_select_game_num_txt_margin_left" android:layout_marginTop="@dimen/game_transfer_list_select_game_num_txt_margin_top" android:text="已选择0款游戏" android:layout_below="@id/game_transfer_bottom_navigation_bar_ll" style="@style/app_base_text_style" />
        <TextView android:id="@id/game_transfer_list_choose_all_txt" android:visibility="gone" android:layout_marginTop="@dimen/game_transfer_list_select_game_num_txt_margin_top" android:layout_marginRight="@dimen/game_transfer_list_item_viewstub_margin_right" android:text="@string/game_transfer_all" android:drawableRight="@drawable/bg_game_transfer_list_select_all" android:drawablePadding="@dimen/game_transfer_list_select_all_game_txt_drawable_padding" android:layout_below="@id/game_transfer_bottom_navigation_bar_ll" android:layout_alignParentRight="true" style="@style/app_base_text_style" />
        <RelativeLayout android:id="@id/game_transfer_history_hint_rl" android:background="@color/handshank_tip_bg" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="@dimen/game_transfer_histroy_hint_rl_height" android:layout_marginTop="@dimen/game_transfer_histroy_hint_vstub_margin_top" android:layout_below="@id/game_transfer_bottom_navigation_bar_ll">
            <TextView android:textSize="@dimen/font_small" android:textColor="@color/white" android:id="@id/game_transfer_history_list_hint_txt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/game_transfer_histroy_hint_txt_margin_left" android:text="@string/hint_game_transfer_histroy_list" android:layout_centerVertical="true" />
            <ImageView android:id="@id/game_transfer_list_hint_close_img" android:padding="3.0dip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="@dimen/game_transfer_histroy_hint_close_img_margin_right" android:src="@drawable/game_transfer_hint_close" android:layout_alignParentRight="true" android:layout_centerVertical="true" />
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@id/game_transfer_list_rv" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_marginBottom="@dimen/game_transfer_list_margin_bottom" android:layout_below="@id/game_transfer_selected_num_txt" />
        <androidx.recyclerview.widget.RecyclerView android:id="@id/game_transfer_historyList_rv" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_marginTop="@dimen/game_transfer_histroy_hint_vstub_margin_top" android:layout_below="@id/game_transfer_history_hint_rl" />
    </RelativeLayout>
    <Button android:enabled="false" android:id="@id/game_transfer_ok_btn" android:visibility="gone" android:text="@string/game_transfer_transfer_ok" style="@style/game_transfer_ok_btn_style" />
</RelativeLayout>