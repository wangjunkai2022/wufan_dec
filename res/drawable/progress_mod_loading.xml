<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <clip>
            <shape>
                <solid android:color="@color/translucent" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <solid android:color="@color/translucent" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress" android:left="@dimen/wdp2" android:top="@dimen/wdp1" android:right="@dimen/wdp2" android:bottom="@dimen/wdp2">
        <clip>
            <shape>
                <corners android:radius="@dimen/wdp2" />
                <gradient android:startColor="#fffb7d3c" android:endColor="#fffb3b0d" android:angle="0.0" />
            </shape>
        </clip>
    </item>
</layer-list>