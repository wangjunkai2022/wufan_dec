<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape
          xmlns:android="http://schemas.android.com/apk/res/android">
            <corners android:radius="@dimen/wdp8" />
            <solid android:color="#ffc1c1c1" />
        </shape>
    </item>
    <item>
        <shape
          xmlns:android="http://schemas.android.com/apk/res/android">
            <solid android:color="@color/white" />
            <corners android:radius="@dimen/wdp8" />
            <stroke android:width="@dimen/wdp1" android:color="#ffc1c1c1" />
        </shape>
    </item>
</selector>