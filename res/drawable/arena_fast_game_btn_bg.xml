<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#ff192733" />
            <corners android:radius="@dimen/wdp6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#ff2576a7" android:endColor="#ff424e7c" android:angle="0.0" />
            <corners android:radius="@dimen/wdp6" />
        </shape>
    </item>
</selector>