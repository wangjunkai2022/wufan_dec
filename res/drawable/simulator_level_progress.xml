<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/wdp8" />
            <gradient android:startColor="#ff203442" android:endColor="#ff203442" android:angle="0.0" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/wdp8" />
                <gradient android:startColor="#ff71c4ff" android:endColor="#ff3d92ff" android:angle="0.0" />
            </shape>
        </clip>
    </item>
</layer-list>